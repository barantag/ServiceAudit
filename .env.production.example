# Public deployment configuration (not secrets)
PILOT_HOSTNAME=serviceaudit-pilot.example.com
SERVICEAUDIT_PUBLIC_ORIGIN=https://serviceaudit-pilot.example.com
SERVICEAUDIT_IMAGE_TAG=replace-with-git-commit

# Server-only application scope
SERVICEAUDIT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000000

# PostgreSQL configuration. Replace every value and keep DATABASE_URL aligned.
POSTGRES_DB=serviceaudit
POSTGRES_USER=serviceaudit_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://serviceaudit_app:replace-with-url-encoded-password@postgres:5432/serviceaudit

# Caddy access gate. Generate the hash with: caddy hash-password
PILOT_BASIC_AUTH_USERNAME=replace-with-pilot-username
PILOT_BASIC_AUTH_PASSWORD_HASH='replace-with-caddy-password-hash'
